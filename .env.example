# Copy this file to .env and fill in your own values.
# Never commit .env to Git — it holds your passwords.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=coursework

# A long random string used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# AI quiz assistant for teachers (optional). Set ONE of these keys; the first
# one found, in this order, is used:
#   GEMINI_API_KEY     free tier   https://aistudio.google.com/apikey        (default model gemini-flash-latest)
#   OPENAI_API_KEY     paid        https://platform.openai.com/api-keys      (default model gpt-5-mini)
#   ANTHROPIC_API_KEY  paid        https://platform.claude.com/settings/keys (default model claude-opus-5-5)
#   GROQ_API_KEY       free tier   https://console.groq.com/keys             (default model openai/gpt-oss-120b)
GEMINI_API_KEY=
# Optional: force a provider (gemini, openai, anthropic, groq) when several keys are set.
# AI_PROVIDER=gemini
# Optional: use a different model from that provider.
# AI_MODEL=gemini-flash-latest
