# Copy this file to .env and fill in your own values.
# Never commit .env to Git — it holds your passwords.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=coursework

# A long random string used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# AI quiz assistant for teachers (optional). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq model to use (defaults to openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b
